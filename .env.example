# Copy to `.env` at the repository root. Used by:
#   - docker compose (variable substitution in docker-compose.yml)
#   - the backend in local dev (`pnpm --filter backend dev` loads ../../.env)
# Never commit a real `.env`.

# --- Ports (host side) -------------------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=3000
POSTGRES_PORT=5432
OLLAMA_PORT=11434

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=lmesh
POSTGRES_PASSWORD=lmesh
POSTGRES_DB=lmesh_cmf
# Used by the backend and Prisma CLI when running on the host (local dev).
# Inside docker compose this is overridden to point at the `postgres` service.
DATABASE_URL=postgresql://lmesh:lmesh@localhost:5432/lmesh_cmf?schema=public

# --- Backend -----------------------------------------------------------------
NODE_ENV=development
# Interface/port the API binds to inside its process.
HOST=0.0.0.0
PORT=3000
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
# Run the idempotent seed (creates test@lmesh.eu / password) on container start.
SEED_ON_START=true

# --- Auth (better-auth) ------------------------------------------------------
# Required, at least 32 characters. Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-me-with-output-of-openssl-rand-base64-48
# Public origin of the web app (the browser-facing URL that receives cookies).
BETTER_AUTH_URL=http://localhost:5173

# --- AI provider -------------------------------------------------------------
# One of: ollama | openrouter | gemini
AI_PROVIDER=openrouter
# Abort an AI call after this many milliseconds (minimum 1000).
AI_REQUEST_TIMEOUT_MS=120000
# Abort when no first token arrives within this many milliseconds (minimum 1000).
AI_FIRST_TOKEN_TIMEOUT_MS=30000
# Maximum number of past conversation messages sent to the model per call.
AI_HISTORY_MAX_MESSAGES=20
# Maximum total characters of history sent to the model per call (minimum 1000).
AI_HISTORY_MAX_CHARS=24000
# Test-only fault injection for e2e. Keep false; only docker-compose.e2e.yml enables it.
AI_FAULT_INJECTION=false

# Ollama (local, no account). From docker compose, use http://host.docker.internal:11434
# for an Ollama on the host, or http://ollama:11434 with `--profile ollama`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
