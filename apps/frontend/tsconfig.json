{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@lmesh/typescript-config/react-vite.json",
  "compilerOptions": {
    "types": [
      "vite/client",
      "node",
      "@testing-library/jest-dom/vitest"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
