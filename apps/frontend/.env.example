# Base URL the browser uses for API calls. Baked in at build time by Vite.
# Keep it relative so requests go through the Vite dev proxy (pnpm dev)
# or the nginx reverse proxy (Docker) without CORS.
VITE_API_BASE_URL=/api/v1

# Dev-server only: where the Vite proxy forwards /api requests.
VITE_DEV_API_PROXY_TARGET=http://localhost:3000

# Dev-server only: serve mocked API data from the MSW service worker
# (no backend needed). Sign in with test@lmesh.eu / password.
# Fault markers in a chat message: [[e2e-fault:timeout]], [[e2e-fault:error-midstream]],
# [[e2e-fault:malformed]], [[e2e-fault:slow]].
VITE_API_MOCKING=false
