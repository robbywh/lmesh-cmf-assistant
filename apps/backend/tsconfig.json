{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@lmesh/typescript-config/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "prisma/**/*",
    "test/**/*",
    "prisma.config.ts",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
