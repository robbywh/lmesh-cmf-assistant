{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS (Node, CommonJS output)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "types": ["node"],

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": false,

    "declaration": false,
    "sourceMap": true,
    "removeComments": false
  }
}
