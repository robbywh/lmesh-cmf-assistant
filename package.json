{
  "name": "lmesh-cmf-assistant",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:backend": "turbo run test --filter=backend",
    "test:frontend": "turbo run test --filter=frontend",
    "test:e2e": "turbo run test:e2e --filter=e2e",
    "test:coverage": "turbo run test:coverage",
    "test:coverage:backend": "turbo run test:coverage --filter=backend",
    "test:coverage:frontend": "turbo run test:coverage --filter=frontend"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
